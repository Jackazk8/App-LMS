<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#F0EFF8"/><stroke android:width="1dp" android:color="#DAD8EC"/><corners android:radius="20dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#DDD6FF"/><stroke android:width="1.5dp" android:color="@color/brand"/><corners android:radius="20dp"/></shape></item>
    <item><shape><solid android:color="@color/brand_light"/><stroke android:width="1.5dp" android:color="@color/brand"/><corners android:radius="20dp"/></shape></item>
</selector>
