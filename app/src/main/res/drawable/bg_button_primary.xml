<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/disabled"/><corners android:radius="20dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#4A31D6"/><corners android:radius="20dp"/></shape></item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="@color/brand" android:endColor="@color/brand_gradient_end"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
