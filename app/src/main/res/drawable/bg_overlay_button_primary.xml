<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#1AFFFFFF"/><corners android:radius="20dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#0F9488"/><corners android:radius="20dp"/></shape></item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#14B8A6" android:endColor="#22D3EE"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
